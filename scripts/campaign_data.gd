			"runes": [["m09_rune_a", "岸石纹接头", "shore"], ["m09_rune_b", "库架纹接头", "archive"], ["m09_rune_c", "返门纹接头", "return"]],
		},
		12: {
			"clue": "m12_true_face", "title": "钟面背后的归家短句",
			"text": ["真实钟面刻着：先让晚归者认出门，再让等候的人看见窗，最后才把消息交给高处的钟。", "门、窗、钟是三枚主线端点的纹样。石灯不会替林恩编号，举灯后按短句连接即可。", "林恩：钟声应该报告有人回来，不是催促所有光离开。"],
			"runes": [["m12_clock_a", "门纹接头", "door"], ["m12_clock_b", "窗纹接头", "window"], ["m12_clock_c", "钟纹接头", "bell"]],
		},
	}
	for id in definitions:
		var definition: Dictionary = definitions[id]
		var map: Dictionary = items[id]
		var clue := _find_object(map, definition.clue)
		clue.title = definition.title
		clue.text = _strings(definition.text)
		for rune in definition.runes:
			var object := _find_object(map, rune[0])
			object.title = rune[1]
			object.glyph = rune[2]
			object.text = _strings(["举灯后，" + str(rune[1]) + "接住了对应的光。林恩照着回流记录确认它的来处与去处。"])
		# Put the clue before its connections, but never encode the answer in the
		# object's iteration order. The rule engine reads the private order field.
		var ordered: Array[Dictionary] = []
		for object in map.objects:
			if object.type == "rune" and object.has("order"):
				ordered.append(object)
		for object in ordered:
			map.objects.erase(object)
		map.objects.erase(clue)
		map.objects.insert(0, clue)
		map.objects.append(ordered[2])
		map.objects.append(ordered[0])
		map.objects.append(ordered[1])
		map.puzzle_hint_id = definition.clue
	var low := _find_object(items[8], "m08_music_a")
