	low.position = Vector2(-16, 11)
	middle.position = Vector2(-4, 13)
	items[9].objects.append(low)
	items[9].objects.append(middle)
	var high := _find_object(items[9], "m09_music_c")
	high.position = Vector2(-10, 13)
	for pair in [[low, "low", "低音灯"], [middle, "mid", "中音灯"], [high, "high", "高音灯"]]:
		var object: Dictionary = pair[0]
		object.tone = pair[1]
		object.tone_title = pair[2]
