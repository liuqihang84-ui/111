static func _ensure_maps() -> void:
	if not _map_cache.is_empty():
		return
	_map_cache = _build_maps()
	_deepen_puzzles(_map_cache)
	_apply_narrative(_map_cache)
	for item in _map_cache:
		_finalize_layout(item)


static func _finalize_layout(map: Dictionary) -> void:
	map.objects.append(_object("m%02d_camp" % map.id, "camp", map.camp.x, map.camp.y, "守灯篝火", ["火苗慢慢稳定下来。这里可以休息、保存旅程，也可以整理护符。", "已经修好的路与记住的线索，不会因一场失误熄灭。"] ))
	var half: Vector2 = map.bounds.size * 0.5
	var protected: Array[Vector2] = [map.spawn, map.camp, map.exit]
	for item in map.objects:
		protected.append(item.position)
	for enemy in map.enemies:
		protected.append(enemy.position)
	var candidates: Array[Vector2] = []
	# Boundary vegetation frames a wide playable clearing. Interior islands leave
	# a continuous central lane and open approaches to every authored interaction.
	for index in range(13):
		var fraction := float(index) / 12.0
		var x := lerpf(-half.x + 1.8, half.x - 1.8, fraction)
		var y := lerpf(-half.y + 1.8, half.y - 1.8, fraction)
		candidates.append(Vector2(x, -half.y + 1.3))
		candidates.append(Vector2(x, half.y - 1.3))
		candidates.append(Vector2(-half.x + 1.3, y))
		candidates.append(Vector2(half.x - 1.3, y))
	for point in [Vector2(-0.62, 0.25), Vector2(-0.37, -0.58), Vector2(0.47, 0.58), Vector2(0.67, -0.1), Vector2(-0.7, -0.25), Vector2(0.27, -0.68)]:
		var center: Vector2 = point * half
		for offset in [Vector2(-0.8, 0), Vector2(0.8, 0), Vector2(0, 0.9)]:
			candidates.append(center + offset)
	for point in candidates:
		if absf(point.x) < 2.8 or not _clear_of_points(point, protected, 2.0):
			continue
		if not map.boss.is_empty() and point.distance_to(map.boss.position) < 6.0:
			continue
		map.trees.append(point)
	for point in [Vector2(-0.3, -0.25), Vector2(0.38, 0.36), Vector2(0.62, -0.55)]:
		var center: Vector2 = point * half
		if _clear_of_points(center, protected, 3.2) and (map.boss.is_empty() or center.distance_to(map.boss.position) > 6.0):
			map.obstacles.append({"position": center, "radius": 1.1})
	# Region-specific middle-ground islands are solid and remain clear of clues.
	for relative in [Vector2(-0.16, 0.18), Vector2(0.22, -0.08), Vector2(-0.2, -0.38), Vector2(0.35, 0.10), Vector2(-0.08, 0.48)]:
		var center: Vector2 = relative * half
		if absf(center.x) < 2.8 or not _clear_of_points(center, protected, 2.4):
			continue
		if not map.boss.is_empty() and center.distance_to(map.boss.position) <= 6.0:
			continue
		if map.region in ["forest", "marsh"]:
			for offset in [Vector2(-0.6, 0), Vector2(0.6, 0), Vector2(0, 0.7)]:
				var tree: Vector2 = center + offset
				if _clear_of_points(tree, protected, 2.0):
					map.trees.append(tree)
		else:
			var visual := "pillar" if map.region == "ruins" else "root" if map.region == "sanctum" else "house"
			var radius := 0.7 if visual == "pillar" else 1.0 if visual == "root" else 1.35
			map.obstacles.append({"position": center, "radius": radius, "visual_type": visual})


static func _find_object(map: Dictionary, id: String) -> Dictionary:
	for item in map.objects:
		if item.id == id:
			return item
	return {}


static func _deepen_puzzles(items: Array[Dictionary]) -> void:
	for map in items:
		for object in map.objects:
			if object.get("ability", "") == "lens":
				object.hidden = true
				object.reveal_radius = 4.0
	var definitions := {
