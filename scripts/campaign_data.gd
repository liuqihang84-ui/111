static func _apply_narrative(items: Array[Dictionary]) -> void:
	var additions: Variant = JSON.parse_string(NARRATIVE_JSON)
	if not additions is Dictionary:
		return
	for key in additions:
		var map: Dictionary = items[int(key)]
		var story: Dictionary = additions[key]
		for line in story.get("intro", []):
			map.intro.append(str(line))
		var insert_at: int = maxi(0, map.outro.size() - 1)
		for line in story.get("outro", []):
			map.outro.insert(insert_at, str(line))
			insert_at += 1
		for object_id in story.get("records", {}):
			var object := _find_object(map, str(object_id))
			if object.is_empty():
				# Stable records may move to a nearby map during layout refinement.
				for other_map in items:
					object = _find_object(other_map, str(object_id))
					if not object.is_empty():
						break
			if not object.is_empty():
				for line in story.records[object_id]:
					object.text.append(str(line))


static func _clear_of_points(point: Vector2, others: Array[Vector2], radius: float) -> bool:
	for other in others:
		if point.distance_to(other) < radius:
			return false
	return true


